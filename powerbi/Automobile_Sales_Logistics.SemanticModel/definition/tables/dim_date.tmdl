/// Calendar covering full years of the data. Marked as the model's date table
/// (dataCategory: Time + key column), which is required for time intelligence.
/// "Has Sales" is TRUE up to the last order date (31 May 2020) so prior-year
/// comparisons only use the same partial period.
table dim_date
	dataCategory: Time

	column Date
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]
		isKey

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

	column Quarter
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

	column 'Month Number'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Number]

	column Month
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'Month Number'

	column 'Year Month'
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month]
		sortByColumn: 'Year Month Sort'

	column 'Year Month Sort'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month Sort]

	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Start]

	column 'Has Sales'
		dataType: boolean
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [Has Sales]

	partition dim_date = calculated
		mode: import
		source =
				VAR _first = MIN ( fact_order_lines[order_date] )
				VAR _last = MAX ( fact_order_lines[order_date] )
				RETURN
					ADDCOLUMNS (
						CALENDAR ( DATE ( YEAR ( _first ), 1, 1 ), DATE ( YEAR ( _last ), 12, 31 ) ),
						"Year", YEAR ( [Date] ),
						"Quarter", "Q" & QUARTER ( [Date] ),
						"Month Number", MONTH ( [Date] ),
						"Month", FORMAT ( [Date], "mmm" ),
						"Year Month", FORMAT ( [Date], "yyyy-mm" ),
						"Year Month Sort", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
						"Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
						"Has Sales", [Date] <= _last
					)
