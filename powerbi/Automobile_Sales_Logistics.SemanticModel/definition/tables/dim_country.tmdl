table dim_country

	column country
		dataType: string
		summarizeBy: none
		sourceColumn: country
		isKey
		dataCategory: Country

	/// EMEA / North America / APAC.
	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	partition dim_country = m
		mode: import
		source =
				let
					Source = Sql.Database(ServerName, DatabaseName),
					Data = Source{[Schema = "gold", Item = "dim_country"]}[Data]
				in
					Data
